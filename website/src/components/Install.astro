---
import Icon from "./Icon.astro";
import { installCommand, setupPrompt } from "../site";

const ways = [
	{ id: "agent", label: "AI agent", copy: setupPrompt, copyLabel: "Copy the agent prompt", toast: "Prompt copied" },
	{ id: "curl", label: "curl", copy: installCommand, copyLabel: "Copy the install command", toast: "Command copied" },
];
---

<div class="install" data-install>
	<div class="tabs" role="tablist" aria-label="How to install Nebula">
		{ways.map((way, index) => (
			<button class:list={["tab", way.id]} type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} data-tab={way.id}>{way.label}</button>
		))}
	</div>
	{ways.map((way, index) => (
		<div class="panel" role="tabpanel" aria-label={way.label} data-panel={way.id} hidden={index !== 0}>
			{way.id === "agent" ? (
				<p class="about">Copy a prompt for Claude Code, Codex or Cursor. It installs Nebula, connects it and sets up permissions.</p>
			) : (
				<>
					<span class="prompt" aria-hidden="true">$</span>
					<code>{way.copy}</code>
				</>
			)}
			<button class="copy" type="button" data-copy={way.copy} data-copied={way.toast} aria-label={way.copyLabel}>
				<span class="copy-icon"><Icon name="copy" size={18} /></span>
				<span class="check-icon"><Icon name="check" size={18} /></span>
			</button>
		</div>
	))}
</div>
<div class="more"><slot /></div>

<style>
	.install {
		border-radius: var(--radius);
		background: var(--surface-1);
		border: 1px solid var(--line-strong);
		overflow: hidden;
	}

	.tabs {
		display: flex;
		gap: 24px;
		padding: 0 18px;
		overflow-x: auto;
		border-bottom: 1px solid var(--line);
		scrollbar-width: none;
	}

	.tab {
		flex: none;
		height: 46px;
		padding: 0;
		border: 0;
		background: transparent;
		font: inherit;
		font-size: 14px;
		font-weight: 620;
		color: var(--text-2);
		cursor: pointer;
		transition:
			color 0.2s var(--ease),
			box-shadow 0.2s var(--ease);
	}

	.tab:hover,
	.tab[aria-selected="true"] {
		color: var(--text-1);
	}

	.tab.agent {
		color: var(--violet-text);
	}

	.tab[aria-selected="true"] {
		box-shadow: inset 0 -2px 0 var(--violet);
	}

	.panel {
		display: flex;
		align-items: center;
		gap: 14px;
		min-height: 64px;
		padding: 10px 10px 10px 18px;
		cursor: pointer;
		transition: background-color 0.2s var(--ease);
	}

	.panel:hover {
		background: var(--surface-2);
	}

	.panel[hidden] {
		display: none;
	}

	.about {
		flex: 1;
		min-width: 0;
		font-size: 15px;
		line-height: 1.45;
		color: var(--text-2);
	}

	.prompt {
		flex: none;
		font-family: var(--mono);
		font-size: 14px;
		color: var(--violet-text);
		user-select: none;
	}

	code {
		flex: 1;
		min-width: 0;
		overflow-x: auto;
		white-space: nowrap;
		font-family: var(--mono);
		font-size: 13.5px;
		color: var(--text-1);
		scrollbar-width: none;
	}

	.copy {
		flex: none;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 0;
		border-radius: 10px;
		background: var(--violet);
		color: #fff;
		cursor: pointer;
		transition: background-color 0.25s var(--ease);
	}

	.copy:hover {
		background: #9a42ff;
	}

	.copy > span {
		grid-area: 1 / 1;
		transition: opacity 0.2s;
	}

	.check-icon,
	.copy:global(.copied) .copy-icon {
		opacity: 0;
	}

	.copy:global(.copied) .check-icon {
		opacity: 1;
	}

	.more {
		margin-top: 20px;
		font-family: var(--mono);
		font-size: 12.5px;
		line-height: 1.6;
		color: var(--text-3);
	}

	.more :global(a) {
		color: var(--lavender);
	}

	.more :global(a:hover) {
		color: var(--text-1);
	}
</style>
