---
import Icon from "./Icon.astro";
import { installCommand } from "../site";
---

<div class="install">
	<div class="titlebar">
		<span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
		<span class="title">Terminal</span>
	</div>
	<div class="line">
		<span class="prompt" aria-hidden="true">$</span>
		<code data-copy-source>{installCommand}</code>
	</div>
	<button class="copy" type="button" data-copy aria-label="Copy the install command">
		<span class="label copy-label"><Icon name="copy" size={15} />Copy</span>
		<span class="label done-label"><Icon name="check" size={15} />Copied</span>
	</button>
</div>
<p class="note">Paste it into Terminal. It puts Nebula in Applications and opens it.</p>

<style>
	.install {
		position: relative;
		border-radius: var(--radius);
		background: var(--surface-1);
		border: 1px solid var(--line-strong);
		box-shadow: 0 30px 80px -40px rgba(140, 40, 255, 0.45);
		overflow: hidden;
	}

	.titlebar {
		display: flex;
		align-items: center;
		height: 44px;
		padding: 0 16px;
		background: var(--surface-2);
		border-bottom: 1px solid var(--line);
	}

	.lights {
		display: flex;
		gap: 7px;
	}

	.lights i {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: var(--surface-3);
		border: 1px solid var(--line-strong);
	}

	.title {
		margin-left: 14px;
		font-family: var(--mono);
		font-size: 12.5px;
		color: var(--text-3);
	}

	.line {
		display: flex;
		gap: 12px;
		padding: 22px 20px 24px;
		font-family: var(--mono);
		font-size: 14px;
		line-height: 1.6;
	}

	.prompt {
		flex: none;
		color: var(--violet-text);
		user-select: none;
	}

	.line code {
		min-width: 0;
		overflow-wrap: anywhere;
		color: var(--text-1);
	}

	.copy {
		position: absolute;
		top: 6px;
		right: 8px;
		display: grid;
		height: 32px;
		padding: 0 12px;
		border: 0;
		border-radius: 8px;
		background: var(--violet);
		color: #fff;
		font-size: 13px;
		font-weight: 620;
		cursor: pointer;
		transition: background-color 0.25s var(--ease);
	}

	.copy:hover {
		background: #9a42ff;
	}

	.label {
		grid-area: 1 / 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 7px;
		transition: opacity 0.2s;
	}

	.done-label,
	.copy:global(.copied) .copy-label {
		opacity: 0;
	}

	.copy:global(.copied) .done-label {
		opacity: 1;
	}

	.note {
		margin-top: 12px;
		font-size: 14px;
		color: var(--text-3);
	}
</style>
