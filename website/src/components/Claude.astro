---
import { Picture } from "astro:assets";
import Chapter from "./Chapter.astro";
import Icon from "./Icon.astro";
import editor from "../assets/shots/editor.png";
import { site } from "../site";

const prompt = "Polish my latest recording, blur the invite emails and export a 1080p MP4.";
const calls = [
	{ tool: "polish", result: "3 zooms · 3 cuts · 2 speed-ups", toast: "Polish: 3 zooms, 3 cuts, 2 speed-ups" },
	{ tool: "add_mask", result: "blur at 9.7–14.0 s", toast: "Add blur" },
	{ tool: "export", result: "Orbit onboarding.mp4 · 1080p60", toast: "Exported Orbit onboarding.mp4" },
];
const tools = ["polish", "edit_clip", "add_zoom", "add_mask", "add_text", "set_style", "captions", "preview_frame", "start_recording", "export", "undo"];
---

<section class="chapter-section claude" id="claude" data-claude>
	<div class="container">
		<Chapter number="05" name="Claude" note="MCP · runs on your Mac" />
		<div class="head">
			<div>
				<h2 data-reveal>Ask for the edit. Watch it happen.</h2>
				<p class="lede" data-reveal>
					Nebula runs an MCP server on your Mac. Claude can read the timeline, look at frames, run
					Polish, edit, record and export in the editor you have open. Each change appears as it
					happens and undoes with ⌘Z.
				</p>
			</div>
			<p class="margin-note" data-reveal><strong>127.0.0.1 only</strong>The server never leaves your Mac and turns away requests from web pages.</p>
		</div>

		<figure class="figure demo">
			<div class="transcript">
				<p class="prompt"><span class="caret">›</span><span><span data-claude-prompt data-text={prompt}>{prompt}</span><span class="cursor" data-claude-cursor></span></span></p>
				<ol class="calls">
					{calls.map((call, index) => (
						<li data-claude-call={index}>
							<span class="tool">{call.tool}</span>
							<span class="result">{call.result}</span>
						</li>
					))}
				</ol>
				<p class="reply" data-claude-reply>
					Done. The video is 10.3 seconds and it's in <span class="path">~/Movies/Nebula Exports</span>.
					Want a 9:16 version too?
				</p>
			</div>

			<div class="shot app">
				<Picture src={editor} alt="The Nebula editor showing Claude's edits" formats={["avif", "webp"]} widths={[720, 1440]} sizes="(min-width: 1100px) 720px, 92vw" />
				<div class="toasts" aria-hidden="true">
					{calls.map((call, index) => (
						<div class="toast" data-claude-toast={index}>
							<span class="toast-text"><b>{call.toast}</b><small>by Claude</small></span>
							<span class="undo">Undo</span>
						</div>
					))}
				</div>
			</div>
			<figcaption class="caption"><span>Claude Code on the left, Nebula on the right. Nothing is uploaded; Claude works on the project you have open.</span></figcaption>
		</figure>

		<div class="setup">
			<div>
				<h3 data-reveal>Connect Claude Code in one line</h3>
				<p data-reveal>Open Nebula, then run this once.</p>
			</div>
			<div class="command" data-reveal>
				<code data-copy-source>{site.mcpCommand}</code>
				<button class="copy" type="button" data-copy aria-label="Copy the command">
					<span class="copy-icon"><Icon name="copy" size={17} /></span>
					<span class="check-icon"><Icon name="check" size={17} /></span>
				</button>
			</div>
		</div>

		<p class="tools" data-reveal>
			<b>Tools include</b>
			{tools.map((tool, index) => (
				<>
					<code>{tool}</code>{index < tools.length - 2 ? ", " : index === tools.length - 2 ? " and " : "."}
				</>
			))}
		</p>
	</div>
</section>

<style>
	.figure {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: 24px;
		margin-top: clamp(48px, 6vw, 80px);
	}

	.figure .caption {
		grid-column: 1 / -1;
		margin-top: -10px;
	}

	/* MARK: Transcript */

	.transcript {
		display: flex;
		flex-direction: column;
		gap: 22px;
		padding: 28px;
		border-radius: var(--radius);
		background: var(--surface-1);
		border: 1px solid var(--line-strong);
		font-size: 15px;
		line-height: 1.6;
	}

	.prompt {
		display: flex;
		gap: 12px;
		color: var(--text-1);
		font-weight: 550;
	}

	.caret {
		color: var(--lavender);
		font-family: var(--mono);
	}

	.cursor {
		display: inline-block;
		width: 8px;
		height: 1.1em;
		margin-left: 2px;
		vertical-align: -0.18em;
		background: var(--lavender);
		opacity: 0;
	}

	.calls {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding-left: 22px;
		border-left: 1px solid var(--line-strong);
		font-family: var(--mono);
		font-size: 13px;
	}

	.calls li {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 12px;
	}

	.tool {
		color: var(--lavender);
	}

	.result {
		color: var(--text-3);
	}

	.reply {
		color: var(--text-2);
	}

	.path {
		font-family: var(--mono);
		font-size: 13.5px;
		color: var(--text-1);
	}

	/* MARK: App */

	.app {
		align-self: start;
	}

	.toasts {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 9%;
		display: grid;
		justify-items: center;
	}

	.toast {
		grid-area: 1 / 1;
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 9px 9px 9px 14px;
		border-radius: var(--radius);
		background: var(--surface-2);
		border: 1px solid var(--line-strong);
		box-shadow: 0 18px 36px -12px #000;
	}

	.toast-text {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
	}

	.toast b {
		font-size: 13px;
		font-weight: 600;
	}

	.toast small {
		font-size: 11.5px;
		color: var(--text-3);
	}

	.undo {
		padding: 5px 9px;
		border-radius: 8px;
		background: var(--surface-3);
		font-size: 12px;
		font-weight: 600;
		color: var(--text-2);
	}

	/* MARK: Setup */

	.setup {
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
		gap: 24px 48px;
		align-items: center;
		margin-top: clamp(64px, 7vw, 96px);
		padding-top: 28px;
		border-top: 1px solid var(--line);
	}

	.setup h3 {
		font-size: 17px;
		font-weight: 600;
	}

	.setup p {
		margin-top: 4px;
		font-size: 15px;
		color: var(--text-2);
	}

	.command {
		display: flex;
		align-items: center;
		gap: 12px;
		min-width: 0;
		padding: 8px 8px 8px 18px;
		border-radius: var(--radius);
		background: var(--surface-1);
		border: 1px solid var(--line-strong);
	}

	.command code {
		flex: 1;
		min-width: 0;
		overflow-x: auto;
		white-space: nowrap;
		font-family: var(--mono);
		font-size: 13px;
		color: var(--text-1);
		scrollbar-width: none;
	}

	.copy {
		flex: none;
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border: 0;
		border-radius: 8px;
		background: var(--surface-3);
		color: var(--text-2);
		cursor: pointer;
	}

	.copy:hover {
		color: var(--text-1);
	}

	.copy > span {
		grid-area: 1 / 1;
		transition: opacity 0.2s;
	}

	.check-icon,
	.copy:global(.copied) .copy-icon {
		opacity: 0;
	}

	.copy:global(.copied) .check-icon {
		opacity: 1;
		color: var(--lavender);
	}

	.tools {
		margin-top: 28px;
		font-size: 15px;
		line-height: 1.9;
		color: var(--text-3);
	}

	.tools b {
		margin-right: 6px;
		font-weight: 600;
		color: var(--text-2);
	}

	.tools code {
		font-family: var(--mono);
		font-size: 13px;
		color: var(--text-2);
	}

	@media (max-width: 960px) {
		.figure,
		.setup {
			grid-template-columns: 1fr;
		}
		.figure .caption {
			margin-top: 0;
		}
	}
</style>
