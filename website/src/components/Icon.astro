---
/** Small line icons (1.6 stroke), drawn to match SF Symbols' weight. */
interface Props {
	name: "download" | "github" | "arrow" | "copy" | "check" | "sparkles" | "scissors" | "zoom" | "gauge" | "eye" | "text" | "captions" | "wave" | "export" | "command" | "display" | "window" | "area" | "mic" | "lock" | "plus";
	size?: number;
	class?: string;
}
const { name, size = 18, class: className } = Astro.props;
const paths: Record<Props["name"], string> = {
	download: '<path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/>',
	github:
		'<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
	arrow: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
	copy: '<rect x="9" y="9" width="11" height="11" rx="2.5"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/>',
	check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
	sparkles: '<path d="M12 3v3m0 12v3M3 12h3m12 0h3"/><path d="m12 8 1.5 2.5L16 12l-2.5 1.5L12 16l-1.5-2.5L8 12l2.5-1.5z"/>',
	scissors: '<circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4 8.1 15.9M14.5 14.5 20 20M8.1 8.1 12 12"/>',
	zoom: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M11 8v6M8 11h6"/>',
	gauge: '<path d="M12 4a9 9 0 0 1 9 9"/><path d="M3 13a9 9 0 0 1 9-9"/><path d="m12 13 4-4"/><circle cx="12" cy="13" r="1.4"/>',
	eye: '<path d="M2.5 12S6 5 12 5s9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7z"/><path d="m4 4 16 16"/>',
	text: '<path d="M5 6V5h14v1M12 5v14M9 19h6"/>',
	captions: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M7 13h4m2 0h4M7 16h8"/>',
	wave: '<path d="M4 10v4M8 7v10M12 4v16M16 8v8M20 11v2"/>',
	export: '<path d="M12 15V4"/><path d="m7 9 5-5 5 5"/><path d="M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"/>',
	command: '<path d="M9 9V6.5A2.5 2.5 0 1 0 6.5 9H9zm0 0v6m0-6h6m-6 6H6.5A2.5 2.5 0 1 0 9 17.5V15zm0 0h6m0-6V6.5A2.5 2.5 0 1 1 17.5 9H15zm0 0v6m0 0h2.5a2.5 2.5 0 1 1-2.5 2.5V15z"/>',
	display: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
	window: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3 9h18"/>',
	area: '<path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3"/>',
	mic: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>',
	lock: '<rect x="5" y="11" width="14" height="9" rx="2.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
	plus: '<path d="M12 5v14M5 12h14"/>',
};
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	set:html={paths[name]}
/>
