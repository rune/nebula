---
import Icon from "./Icon.astro";

interface Props {
	command: string;
}

const { command } = Astro.props;
---

<div class="command">
	<code>{command}</code>
	<button class="copy" type="button" data-copy={command} data-copied="Command copied" aria-label="Copy the command">
		<span class="copy-icon"><Icon name="copy" size={17} /></span>
		<span class="check-icon"><Icon name="check" size={17} /></span>
	</button>
</div>

<style>
	.command {
		display: flex;
		align-items: center;
		gap: 12px;
		min-width: 0;
		padding: 8px 8px 8px 18px;
		border-radius: var(--radius);
		background: var(--surface-1);
		border: 1px solid var(--line-strong);
	}

	.command code {
		flex: 1;
		min-width: 0;
		overflow-x: auto;
		white-space: nowrap;
		font-family: var(--mono);
		font-size: 13px;
		color: var(--text-1);
		scrollbar-width: none;
	}

	.copy {
		flex: none;
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border: 0;
		border-radius: 8px;
		background: var(--surface-3);
		color: var(--text-2);
		cursor: pointer;
	}

	.copy:hover {
		color: var(--text-1);
	}

	.copy > span {
		grid-area: 1 / 1;
		transition: opacity 0.2s;
	}

	.check-icon,
	.copy:global(.copied) .copy-icon {
		opacity: 0;
	}

	.copy:global(.copied) .check-icon {
		opacity: 1;
		color: var(--lavender);
	}
</style>
