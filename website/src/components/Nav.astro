---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { links } from "../site";

/** The chapters, in page order. The scrubber under the bar marks where each one starts. */
const chapters = [
	{ id: "record", name: "Record" },
	{ id: "polish", name: "Polish" },
	{ id: "look", name: "Look" },
	{ id: "edit", name: "Edit" },
	{ id: "claude", name: "Claude" },
	{ id: "faq", name: "FAQ" },
];
---

<header class="nav" data-nav>
	<div class="container bar">
		<a class="brand" href="#top" aria-label="Nebula home">
			<Logo size={24} />
			<span>Nebula</span>
		</a>
		<nav class="links" aria-label="Chapters">
			{chapters.map((chapter) => <a href={`#${chapter.id}`} data-nav-link={chapter.id}>{chapter.name}</a>)}
		</nav>
		<div class="actions">
			<a class="github" href={links.github} target="_blank" rel="noopener noreferrer" aria-label="Nebula on GitHub"><Icon name="github" size={19} /></a>
			<a class="button primary small" href={links.dmg}>Download</a>
		</div>
	</div>
	<!-- The page as a timeline: one marker per chapter and a playhead at your scroll position. -->
	<div class="container scrubber" aria-hidden="true" data-scrubber>
		<div class="track">
			{chapters.map((chapter) => <a class="mark" href={`#${chapter.id}`} tabindex="-1" data-mark={chapter.id}><span>{chapter.name}</span></a>)}
			<span class="playhead" data-playhead></span>
		</div>
	</div>
</header>

<style>
	.nav {
		position: fixed;
		inset: 0 0 auto;
		z-index: 50;
		border-bottom: 1px solid transparent;
		transition:
			background-color 0.4s var(--ease),
			border-color 0.4s var(--ease);
	}

	.nav.scrolled {
		background: rgba(5, 5, 7, 0.78);
		backdrop-filter: saturate(1.3) blur(16px);
		-webkit-backdrop-filter: saturate(1.3) blur(16px);
		border-bottom-color: var(--line);
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 32px;
		height: 64px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 16px;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.links {
		display: flex;
		gap: 26px;
		margin-left: auto;
	}

	.links a {
		font-size: 14px;
		font-weight: 550;
		color: var(--text-2);
		transition: color 0.2s;
	}

	.links a:hover,
	.links a.current {
		color: var(--text-1);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.github {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		color: var(--text-2);
		transition: color 0.2s;
	}

	.github:hover {
		color: var(--text-1);
	}

	/* Scrubber: hidden at the top of the page, slides in once you start reading. */
	.scrubber {
		height: 0;
		overflow: visible;
		opacity: 0;
		transition: opacity 0.4s var(--ease);
	}

	.nav.scrolled .scrubber {
		opacity: 1;
	}

	.track {
		position: relative;
		top: -1px;
		height: 7px;
		background: repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px 8px) left top / 100% 4px no-repeat;
	}

	.mark {
		position: absolute;
		top: 0;
		width: 1px;
		height: 7px;
		background: var(--tick);
	}

	/* A wide invisible hit area, with the chapter name shown on hover. */
	.mark::before {
		content: "";
		position: absolute;
		inset: -6px -10px;
	}

	.mark span {
		position: absolute;
		top: 12px;
		left: 50%;
		transform: translate(-50%, -4px);
		padding: 3px 8px;
		border-radius: 6px;
		background: var(--surface-3);
		border: 1px solid var(--line-strong);
		font-size: 12px;
		font-weight: 600;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transition:
			opacity 0.2s,
			transform 0.2s var(--ease);
	}

	.mark:hover span {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.playhead {
		position: absolute;
		top: -1px;
		left: 0;
		width: 2px;
		height: 9px;
		border-radius: 1px;
		background: var(--violet);
		will-change: transform;
	}

	@media (max-width: 860px) {
		.links {
			display: none;
		}
		.actions {
			margin-left: auto;
		}
	}
</style>
